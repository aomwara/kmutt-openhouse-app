datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Students {
  id            Int          @id @default(autoincrement())
  citizen_id    String
  first_name    String
  last_name     String
  school        String
  province      String
  email         String       @unique
  phone         String
  password_hash String
  created_at    DateTime     @default(now())
  OAuthCode     OAuthCode[]
  oAuthToken    oAuthToken[]
}

model Staffs {
  id            Int             @id @default(autoincrement())
  username      String          @unique
  password_hash String
  name          String
  email         String          @unique
  created_at    DateTime        @default(now())
  ActivityStaff ActivityStaff[]
}

model APIUsers {
  id            Int      @id @default(autoincrement())
  username      String   @unique
  password_hash String
  email         String   @unique
  created_at    DateTime @default(now())
}

model Faculty {
  id         Int      @id @default(autoincrement())
  name       String
  created_at DateTime @default(now())

  departments Department[]
}

model Department {
  id         Int          @id @default(autoincrement())
  name       String
  facultyId  Int
  faculty    Faculty      @relation(fields: [facultyId], references: [id])
  created_at DateTime     @default(now())
  activities Activities[]
}

model Activities {
  id               Int          @id @default(autoincrement())
  title            String
  description      String
  date             DateTime
  location         String
  created_at       DateTime     @default(now())
  max_participants Int
  activity_type    ActivityType
  departmentId     Int
  department       Department   @relation(fields: [departmentId], references: [id])

  ActivityStaff ActivityStaff[]
}

enum ActivityType {
  workshop
  seminar
  meeting
}

model ActivityStaff {
  activityId Int
  staffId    Int
  created_at DateTime @default(now())

  activity Activities @relation(fields: [activityId], references: [id])
  staff    Staffs     @relation(fields: [staffId], references: [id])

  @@id([activityId, staffId])
}

// OAuth2
model OAuthClient {
  id            Int         @id @default(autoincrement())
  name          String
  client_id     String      @unique
  client_secret String
  redirect_uris String
  created_at    DateTime    @default(now())
  codes         OAuthCode[]
}

model OAuthCode {
  code       String   @id
  studentId  Int
  clientId   String
  expires_at DateTime

  student Students    @relation(fields: [studentId], references: [id])
  client  OAuthClient @relation(fields: [clientId], references: [client_id])

  created_at DateTime @default(now())
}

model oAuthToken {
  id           Int      @id @default(autoincrement())
  access_token String   @unique
  studentId    Int
  clientId     String
  expires_at   DateTime

  student    Students @relation(fields: [studentId], references: [id])
  created_at DateTime @default(now())
}
